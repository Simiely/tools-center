# ===== 运行时数据 =====
data/
*.log
*.log.err

# ===== 工具目录(挂载卷,工具代码在各仓库,不入库) =====
tools/*
# 例外:官方内置工具(积分仪表盘)入库,但排除其凭证/数据文件
!tools/wb-credits/
!tools/wb-credits/**
tools/wb-credits/wb-accounts.json
tools/wb-credits/wb-sync.json
tools/wb-credits/wb-history.json
tools/wb-credits/wb-last-data.json
tools/wb-credits/*.log
tools/wb-credits/*.log.err

# ===== 工具凭证/敏感(严禁上传) =====
tools/*/wb-accounts.json
tools/*/wb-sync.json
tools/*/wb-history.json
tools/*/wb-last-data.json
tools/*/data/

# ===== 系统 =====
.DS_Store
Thumbs.db
node_modules/
docker-compose.local.yml
deploy-local.sh
.local/
# 本地 Docker 测试目录(含运行数据/凭证,不入库)
deploy/
